  "key_brush":  { "message": "なぞって複数選択" },
  "key_all":    { "message": "すべて選択" },
  "key_clear":  { "message": "クリア" },
  "key_delete": { "message": "削除" },
  "key_exit":   { "message": "終了" },

  "btn_clear": { "message": "クリア" },
  "btn_del1":  { "message": "1件のチャットを削除" },
