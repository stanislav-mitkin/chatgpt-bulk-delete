  "selN": { "message": "$COUNT$件選択", "placeholders": { "count": { "content": "$1" } } },

  "conf1": { "message": "↩ をもう一度押して1件を削除" },
  "confN": { "message": "↩ をもう一度押して$COUNT$件を削除", "placeholders": { "count": { "content": "$1" } } },

  "done1":    { "message": "1件のチャットを削除しました" },
  "doneN":    { "message": "$COUNT$件のチャットを削除しました", "placeholders": { "count": { "content": "$1" } } },
  "doneFail": { "message": "$DONE$件削除、$FAILED$件失敗", "placeholders": { "done": { "content": "$1" }, "failed": { "content": "$2" } } }
